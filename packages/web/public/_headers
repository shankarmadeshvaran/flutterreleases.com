/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*.png
  Cache-Control: public, max-age=31536000, immutable

/*.svg
  Cache-Control: public, max-age=31536000, immutable

/*.ico
  Cache-Control: public, max-age=31536000, immutable

/*.webmanifest
  Cache-Control: public, max-age=31536000, immutable

/releases.json
  Cache-Control: public, max-age=300, stale-while-revalidate=86400

/feed.xml
  Cache-Control: public, max-age=300, stale-while-revalidate=86400

/sitemap.xml
  Cache-Control: public, max-age=300, stale-while-revalidate=86400

/llms-full.txt
  Cache-Control: public, max-age=300, stale-while-revalidate=86400

/links.html
  Cache-Control: public, max-age=300, stale-while-revalidate=86400
